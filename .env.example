# ───────────── WhatsApp ─────────────
# Laisse vide au premier lancement : le site te donnera ton SESSION_ID après l'appairage.
SESSION_ID=
# Mot de passe du site (appairage, export de session, déconnexion). Fortement recommandé.
ADMIN_PASSWORD=change-moi

# ───────────── NVIDIA ─────────────
# Clé sur https://build.nvidia.com (bouton "Get API Key"), elle commence par nvapi-
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Modèle qui regarde les images reçues (doit accepter les images)
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ───────────── Bot ─────────────
PREFIX=.
BOT_NAME=Nova
# Ton prénom (sinon le nom de ton profil WhatsApp est utilisé)
OWNER_NAME=
TIME_ZONE=Europe/Paris
LOG_LEVEL=info

# ───────────── Stockage ─────────────
# Facultatif. Sans MONGODB_URI, tout est enregistré dans DATA_DIR (sur Render, ce dossier est vidé à chaque redémarrage).
MONGODB_URI=
MONGODB_DB=whatsapp_ai_bot
DATA_DIR=./data

PORT=3000

# ───────────── Musique & vidéos (.song / .video) ─────────────
# Tout est automatique : yt-dlp est téléchargé dans bin/ pendant « npm install » (ou au premier usage)
# et ffmpeg vient du paquet ffmpeg-static. Tous ces réglages sont facultatifs.
# Si YouTube bloque le serveur (« Sign in to confirm you're not a bot ») : tes cookies YouTube,
# c'est-à-dire le contenu d'un fichier cookies.txt (format Netscape), brut ou encodé en base64.
YT_COOKIES=
# … ou le chemin d'un fichier cookies.txt (sur Render : Secret File « cookies.txt », lu automatiquement)
YT_COOKIES_FILE=
SONG_MAX_MINUTES=30
VIDEO_MAX_MINUTES=15
# Hauteur max des vidéos (480 = bon compromis qualité/poids pour WhatsApp)
VIDEO_MAX_HEIGHT=480
MEDIA_MAX_MB=100
# Avancé : chemins perso et options yt-dlp en plus
YTDLP_PATH=
FFMPEG_PATH=
YTDLP_ARGS=
